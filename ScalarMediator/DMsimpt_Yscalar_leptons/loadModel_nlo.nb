Cell["Compute Counter Terms and write NLO output", "Section",
 CellChangeTimes->{{3.888586705005823*^9, 3.888586713854385*^9}, 
   3.889268104737523*^9, 
   3.8908449134464617`*^9},ExpressionUUID->"08c7b670-994e-415b-9435-\
f6f9eafb3471"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$FeynRulesPath", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "$UserBaseDirectory", ",", "\"\<Applications\>\"", ",", 
      "\"\<FeynRules\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Path", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", "$FeynRulesPath", "}"}], ",", "$Path"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.8896068201764107`*^9, 3.891443539180497*^9, {3.901710811822209*^9, 
   3.901710812158687*^9}, {3.951900524244628*^9, 3.951900537366322*^9}, {
