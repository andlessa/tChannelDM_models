(*******************************************************************************)
(*******************************************************************************)
(****** t-channel Dark Matter Simplfied Model                             ******)
(****** with a scalar Lepton-like Mediator                                ******)
(******                                                                   ******)
(****** Authors:  Andre Lessa                                             ******)
(******                                                                   ******)
(****** The model is a version of the model presented in arXiv:1803.10379 ******)
(****** and following the notation of the DMsimpt_t_leptons model from    ******)
(****** "http://feynrules.irmp.ucl.ac.be/wiki/DMsimpt_leptons/"           ******)
(******  written by Chiara Arina                                          ******)
(*******************************************************************************)
(*******************************************************************************)

M$ModelName = "DMsimpT_Yscalar_leptons";

M$Information = {Authors -> {"Andre Lessa"}, 
                 Version -> "1.1",
                 Date -> "18.06.2026"
                };
FeynmanGauge = True;

M$InteractionOrderHierarchy = {  {NP,  1}, {QCD, 1}, {QED, 2} };

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

 (* Internal parameters*)
  muYS2   == { 
              TeX->Subscript[\[Mu],YS],
              ComplexParameter -> False, 
              ParameterType->Internal, 
              Value->MY^2 - lamYH vev^2/2,  
              Description->"Scalar mediator Lagrangian mass parameter"
            },
                                                                                                  
 (* External NP parameters*)
  yFeR  == { 
              TeX->Subscript[y,YeR],
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->1.0, 
              InteractionOrder->{NP ,1}, 
              Description->"Dark fermion - scalar lepton - SM RH electron Yukawa"
            },

  yFmuR == { 
              TeX->Subscript[y,YmuR], 
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->0.0, 
              InteractionOrder->{NP ,1}, 
              Description->"Dark fermion - scalar lepton - SM RH muon Yukawa"
            },

  yFtaR == { 
              TeX->Subscript[y,YtaR],
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->0.0, 
              InteractionOrder->{NP ,1}, 
              Description->"Dark fermion - scalar lepton - SM RH tau Yukawa"
            },

  lamYH == { 
              TeX->Subscript[\[Lambda],YH], 
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->0.0,
              InteractionOrder->{NP ,1}, 
              Description->"Scalar lepton - Higgs doublet coupling"
            },

  lamY  == { 
              TeX->Subscript[\[Lambda],Y],  
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->0.0,     
              InteractionOrder->{NP, 1}, 
              Description->"Scalar lepton quartic interaction"
            }

};

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {


(* The dark Fermion *)
F[100] == { 
            ClassName -> Xm, 
            SelfConjugate-> True,
            Mass->{MX,  100.0},  
            Width-> 0, 
            ParticleName-> "Xm", 
            PDG->52, 
            PropagatorLabel->"Xm", 
            PropagatorType->Straight,
            FullName         -> {"Dark fermion"} 
        },

(* Heavy charged scalar lepton: Physical *)
S[200] == { 
            ClassName -> YSe, 
            SelfConjugate -> False,
            Indices -> {}, 
            QuantumNumbers -> {Q -> -1, LeptonNumber -> 1},
            PDG -> {5920011},
            Mass  -> {MY, 500.0},
            Width -> {WY, 9.2}
          },
(* Define a gauge state to assign hypercharge. In this case the gauge mass basis are the same *)
S[201] == { 
            ClassName -> YSeW, 
            Unphysical -> True, 
            Indices -> {}, 
            SelfConjugate -> False,
            QuantumNumbers -> {Y -> -1, LeptonNumber -> 1},
            Definitions -> { YSeW -> YSe } 
          }
   
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

LNP := Block[{LKinDM, LKinYS, LintF, LintYH, ii,mu,sp,feynmangaugerules},

    feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar ->0}, {}];  
    LkinYS := DC[YSeWbar,mu] DC[YSeW,mu] - muYS2 YSebar*YSe;
    LkinDM := I/2*Xmbar.Ga[mu].DC[Xm,mu] - 1/2 MX Xmbar.Xm;

    LYukawaBSM := - YSebar*(yFeR  Xmbar[sp].lR[sp,1] + yFmuR Xmbar[sp].lR[sp,2] + yFtaR Xmbar[sp].lR[sp,3]);
    LintF := LYukawaBSM + HC[LYukawaBSM];

    LintYH :=  ExpandIndices[
                              -(lamY/4) (YSe*YSebar)^2 - lamYH YSe*YSebar Phibar[ii] Phi[ii], 
                              FlavorExpand->{SU2D,SU2W}
                            ]/.feynmangaugerules;

    LkinDM + LintYH + LkinYS + LintF
];
