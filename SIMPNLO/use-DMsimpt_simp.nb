  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{"$FeynRulesPath", ",", "\"\<NLOCT.m\>\""}], "}"}], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WriteCT", "[", 
   RowBox[{
   "\"\<DMsimpt_v1_2_FA/DMsimpt_v1_2_FA\>\"", ",", 
    "\"\<DMsimpt_v1_2_FA/DMsimpt_v1_2_FA\>\"", ",", "\[IndentingNewLine]", 
