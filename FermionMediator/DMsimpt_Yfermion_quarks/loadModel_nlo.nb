Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"WriteCT", "[", 
   RowBox[{
   "\"\<./DMsimpt_Yfermion_quarks_NLO_FA/DMsimpt_Yfermion_quarks_NLO_FA\>\"", 
    ",", 
    RowBox[{"Exclude4ScalarsCT", "\[Rule]", "True"}], ",", 
    RowBox[{
    "Output", "\[Rule]", " ", "\"\<./DMsimpt_Yfermion_quarks_NLO_FA_CT\>\""}],
     ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
