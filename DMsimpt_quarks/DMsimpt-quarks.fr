(*******************************************************************************)
(*******************************************************************************)
(****** t-channel Dark Matter Simplfied Model with a Quark-like           ******)
(****** (top-like or bottom-like) Mediator                                ******)
(******                                                                   ******)
(****** Authors:  Andre Lessa                                             ******)
(******                                                                   ******)
(****** The model is a simplified version of the model defined here:      ******)
(****** "https://feynrules.irmp.ucl.ac.be/wiki/DMsimpt"                   ******)
(******  written by Benjamin Fuks                                         ******)
(*******************************************************************************)
(*******************************************************************************)

M$ModelName = "DMsimpt-quarks";

M$Information = {Authors -> {"Andre Lessa"}, 
                 Version -> "1.1",
                 Date -> "22.06.2026"
                };
FeynmanGauge = True;

M$InteractionOrderHierarchy = {  {NP,  1}, {QCD, 1}, {QED, 2} };

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

 (* Internal parameters*)
  muXs2   == { 
              TeX->Subscript[\[Mu],Xs],
              ComplexParameter -> False, 
              ParameterType->Internal, 
              Value->MX^2 - lamXsH vev^2,  
              Description->"Dark scalar Lagrangian mass parameter"
            },
                                                                                                  
 (* External NP parameters*)
  yFqR  == { 
              TeX->Subscript[y,YqR],
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->10^(-7), 
              InteractionOrder->{NP ,1}, 
              Description->"Dark scalar - heavy quark - 1st/2nd generation quarks Yukawa"
            },

  yFbR == { 
              TeX->Subscript[y,YbR], 
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->10^(-7), 
              InteractionOrder->{NP ,1}, 
              Description->"Dark scalar - heavy quark - bottom quark Yukawa"
            },

  yFtR == { 
              TeX->Subscript[y,YtR],
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->10^(-7), 
              InteractionOrder->{NP ,1}, 
              Description->"Dark scalar - heavy quark - top quark Yukawa"
            },

  lamXsH == { 
              TeX->Subscript[\[Lambda],xsh], 
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->0.02,
              InteractionOrder->{NP ,1}, 
              Description->"Dark scalar - Higgs doublet coupling"
            },

  lamXs  == { 
              TeX->Subscript[\[Lambda],xs],  
              ComplexParameter -> False, 
              ParameterType->External, 
              Value->0.1,     
              InteractionOrder->{NP, 1}, 
              Description->"Dark scalar quartic interaction"
            }

};

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {


(* The dark scalar *)
S[100] == { 
            ClassName -> Xs, 
            SelfConjugate-> True,
            Mass->{MX,  100.0},  
            Width-> 0,
            PDG->51, 
            PropagatorLabel->"Xs", 
            PropagatorType->ScalarDash, 
            ParticleName     -> {"Xs"},
            FullName         -> {"Dark scalar"} 
        },

(* Heavy top-like quark *)
F[200] == { 
            ClassName -> YFu, 
            SelfConjugate -> False,
            Indices -> {Index[Colour]}, 
            QuantumNumbers -> {Q -> 2/3},
            ParticleName     -> {"YFu"},
            AntiParticleName -> {"YFu~"},
            PDG -> {5910002},
            Mass  -> {MYu, 500.0},
            Width -> {WYu, 1.375*10^(-13)},
            FullName -> {"Up-type Mediator"}
          },

F[201] == { 
            ClassName      -> YFuL,
            Unphysical     -> True, 
            Indices        -> {Index[Colour]},
            SelfConjugate  -> False,
            QuantumNumbers -> {Y -> 2/3},
            Definitions    -> { YFuL[sp1_,cc_] :> Module[{sp2}, ProjM[sp1,sp2] YFu[sp2,cc]] } 
          },

F[202] == { 
            ClassName      -> YFuR,
            Unphysical     -> True, 
            Indices        -> {Index[Colour]},
            SelfConjugate  -> False,
            QuantumNumbers -> {Y -> 2/3},
            Definitions    -> { YFuR[sp1_cc_] :> Module[{sp2}, ProjP[sp1,sp2] YFu[sp2,cc]] } 
          },

(* Heavy bottom-like quark *)
F[300] == { 
            ClassName -> YFd, 
            SelfConjugate -> False,
            Indices -> {Index[Colour]}, 
            QuantumNumbers -> {Q -> -1/3},
            ParticleName     -> {"YFd"},
            AntiParticleName -> {"YFd~"},
            PDG -> {5910001},
            Mass  -> {MYd, 500.0},
            Width -> {WYd, 1.375*10^(-13)},
            FullName -> {"Up-type Mediator"}
          },

F[301] == { 
            ClassName      -> YFdL,
            Unphysical     -> True, 
            Indices        -> {Index[Colour]},
            SelfConjugate  -> False,
            QuantumNumbers -> {Y -> -1/3},
            Definitions    -> { YFdL[sp1_,cc_] :> Module[{sp2}, ProjM[sp1,sp2] YFd[sp2,cc]] } 
          },
          
F[302] == { 
            ClassName      -> YFdR,
            Unphysical     -> True, 
            Indices        -> {Index[Colour]},
            SelfConjugate  -> False,
            QuantumNumbers -> {Y -> -1/3},
            Definitions    -> { YFdR[sp1_,cc_] :> Module[{sp2}, ProjP[sp1,sp2] YFd[sp2,cc]] } 
          }                 
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

LNP := Block[{LKinDM, LKinYF, LintF,LintXs,cc,ii,mu,sp,feynmangaugerules},

    feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar ->0}, {}];  
    LkinYF := I*( YFuLbar.Ga[mu].DC[YFuL, mu] + YFuRbar.Ga[mu].DC[YFuR, mu] + YFdLbar.Ga[mu].DC[YFdL, mu] + YFdRbar.Ga[mu].DC[YFdR, mu] ) - MYu YFubar.YFu - MYd YFdbar.YFd;

    LkinDM :=  1/2 del[Xs,mu]^2 - 1/2 muXs2 Xs^2;

    LYukawaBSM := - Xs*yFqR*(YFubar[sp,cc].uR[sp,1,cc] + YFubar[sp,cc].uR[sp,2,cc])\
                  - Xs*yFqR*(YFdbar[sp,cc].dR[sp,1,cc] + YFdbar[sp,cc].dR[sp,2,cc])\
                  - Xs*yFtR*(YFubar[sp,cc].uR[sp,3,cc] + YFubar[sp,cc].uR[sp,3,cc])\
                  - Xs*yFbR*(YFdbar[sp,cc].dR[sp,3,cc] + YFdbar[sp,cc].dR[sp,3,cc]);
                  
    LintF := LYukawaBSM + HC[LYukawaBSM];

    LintXs :=  ExpandIndices[
                              -(lamXs/4) Xs^4 - lamXsH Xs^2 Phibar[ii] Phi[ii], 
                              FlavorExpand->{SU2D,SU2W}
                            ]/.feynmangaugerules;

    LkinDM + LintXs + LkinYF + LintF
];
